  - 'readability-container-contains'                         #(ENABLED)(Yes)(Readability,Replaces .find(...) != .end() with .contains(...) for C++20 associative containers.)
  - 'readability-delete-null-pointer'                        #(ENABLED)(Yes)(Readability,Removes unnecessary nullptr checks before calling delete.)
  - 'readability-duplicate-include'                          #(ENABLED)(Yes)(Readability,Warns on duplicate #include directives within the same source file.)
  - 'readability-enum-initial-value'                         #(ENABLED)(Yes)(Readability,Enforces explicit or consistent initial value assignments across enum members.)
  - 'readability-function-size'                              #(ENABLED)(No)(Readability,"Flags functions exceeding configured line count, parameter count, or complexity thresholds.")
  - 'readability-identifier-naming'                          #(ENABLED)(Yes)(Readability,"Enforces configured identifier naming conventions (camelCase, PascalCase, snake_case, etc.).")
  - 'readability-inconsistent-declaration-parameter-name'    #(ENABLED)(Yes)(Readability,Warns when parameter names in function declarations differ from definitions.)
  - 'readability-inconsistent-ifelse-braces'                 #(ENABLED)(Yes)(Readability,Ensures all branches in an if-else chain consistently use or omit braces.)
  - 'readability-isolate-declaration'                        #(ENABLED)(Yes)(Readability,Splits multi-variable declarations onto separate lines for readability.)
  - 'readability-misleading-indentation'                     #(ENABLED)(No)(Readability,Warns on misleading code indentation that does not match actual control flow logic.)
  - 'readability-misplaced-array-index'                      #(ENABLED)(Yes)(Readability,Warns on array indexing written as index[array] instead of array[index].)
  - 'readability-operators-representation'                   #(ENABLED)(Yes)(Readability,"Prefers standard token representations over alternative operator keywords (e.g., && instead of and).")
  - 'readability-redundant-control-flow'                     #(ENABLED)(Yes)(Readability,Removes redundant return; or continue; statements at the end of functions or loops.)
  - 'readability-redundant-declaration'                      #(ENABLED)(Yes)(Readability,Removes redundant repeated forward declarations of functions or variables.)
  - 'readability-redundant-function-ptr-dereference'         #(ENABLED)(Yes)(Readability,Removes unnecessary dereferences or address-of operators applied to function pointers.)
  - 'readability-redundant-inline-specifier'                 #(ENABLED)(Yes)(Readability,"Removes redundant inline specifiers (e.g., on class-internal member functions or constexpr functions).")
  - 'readability-redundant-parentheses'                      #(ENABLED)(Yes)(Readability,Removes redundant parentheses around expressions.)
  - 'readability-redundant-preprocessor'                     #(ENABLED)(No)(Readability,"Detects redundant preprocessor directives (e.g., duplicate identical #ifdef blocks).")
  - 'readability-redundant-smartptr-get'                     #(ENABLED)(Yes)(Readability,Removes unnecessary .get() calls on smart pointers when implicit conversion or operator context exists.)
  - 'readability-redundant-string-init'                      #(ENABLED)(Yes)(Readability,"Removes redundant empty string literal initializations (std::string s = """").")
  - 'readability-redundant-typename'                         #(ENABLED)(Yes)(Readability,Removes redundant typename keywords in non-dependent template contexts.)
  - 'readability-reference-to-constructed-temporary'         #(ENABLED)(No)(Readability,Detects binding local const references to newly constructed temporary objects.)
  - 'readability-simplify-subscript-expr'                    #(ENABLED)(Yes)(Readability,Replaces .data()[i] or &[i] with standard subscript operator usage ([i]).)
  - 'readability-string-compare'                             #(ENABLED)(Yes)(Readability,Replaces .compare(...) == 0 calls with standard equality operators (== or !=).)
  - 'readability-suspicious-call-argument'                   #(ENABLED)(No)(Readability,Flags function calls where argument names closely match parameter names in different positions.)
  - 'readability-uniqueptr-delete-release'                   #(ENABLED)(Yes)(Readability,Replaces delete ptr.release() with ptr.reset().)
  - 'readability-uppercase-literal-suffix'                   #(ENABLED)(Yes)(Readability,"Enforces uppercase literal suffixes (e.g., 100U, 1.0F) for consistency and clarity.")
  - 'readability-use-anyofallof'                             #(ENABLED)(No)(Readability,"Replaces manual checking loops with std::any_of, std::all_of, or std::none_of.")
  - 'readability-use-std-min-max'                            #(ENABLED)(Yes)(Readability,Replaces ternary or conditional expressions calculating minimum/maximum values with std::min or std::max.)

