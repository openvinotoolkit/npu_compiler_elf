  - '-misc-use-anonymous-namespace'                          #(TO_REVIEW:hits-in-clang-tidy-logs=2)(No)(Misc,Replaces static function/variable declarations with anonymous namespaces in C++ files.)
  - '-modernize-avoid-variadic-functions'                    #(TO_REVIEW:hits-in-clang-tidy-logs=2)(No)(Modernize,Discourages C-style variadic functions in favor of variadic templates or std::initializer_list.)
  - '-performance-no-int-to-ptr'                             #(TO_REVIEW:hits-in-clang-tidy-logs=2)(No)(Performance,Discourages integer-to-pointer conversions in performance-critical code sections.)

# Treat all enabled warnings as errors
WarningsAsErrors: '*'

# Controls how clang-tidy formats code when applying automatic fixes ('clang-tidy -fix').
# 'file' forces clang-tidy to read and respect project '.clang-format' file.
FormatStyle: 'file'

# Files to exclude from header filter
ExcludeHeaderFilterRegex: '3rdparty/.*'
