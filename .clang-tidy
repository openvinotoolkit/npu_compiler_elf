  - '-bugprone-suspicious-memory-comparison'                 #(TO_REVIEW:hits-in-clang-tidy-logs=2)(No)(Bugprone,Flags memcmp used on non-trivially copyable objects or padding-containing structs.)
  - '-bugprone-switch-missing-default-case'                  #(TO_REVIEW:hits-in-clang-tidy-logs=2)(No)(Bugprone,Warns on non-enum switch statements that lack a default case.)
  - '-bugprone-unused-local-non-trivial-variable'            #(TO_REVIEW:hits-in-clang-tidy-logs=2)(No)(Bugprone,Flags unused local variables even when they have non-trivial constructors/destructors.)
  - '-bugprone-unused-return-value'                          #(TO_REVIEW:hits-in-clang-tidy-logs=2)(No)(Bugprone,Warns when return values from functions marked [[nodiscard]] are ignored.)
  - '-concurrency-mt-unsafe'                                 #(TO_REVIEW:hits-in-clang-tidy-logs=2)(No)(Concurrency,Flags calls to thread-unsafe functions in multi-threaded programs.)
