  - '-misc-use-internal-linkage'                             #(TO_REVIEW:hits-in-clang-tidy-logs=14)(Yes)(Misc,Suggests marking functions/variables used only in one translation unit with internal linkage (static).)
  - '-modernize-use-default-member-init'                     #(TO_REVIEW:hits-in-clang-tidy-logs=12)(Yes)(Modernize,Converts constructor member initialization lists into default in-class member initializers.)
  - '-readability-non-const-parameter'                       #(TO_REVIEW:hits-in-clang-tidy-logs=11)(Yes)(Readability,Marks function reference/pointer parameters as const when the function does not modify them.)
  - '-bugprone-crtp-constructor-accessibility'               #(TO_REVIEW:hits-in-clang-tidy-logs=10)(Yes)(Bugprone,Ensures CRTP base class constructors are marked private or protected.)
  - '-modernize-type-traits'                                 #(TO_REVIEW:hits-in-clang-tidy-logs=10)(Yes)(Modernize,"Replaces C++11 type traits syntax (e.g., typename std::enable_if<...>::type) with C++14 _t and _v aliases.")
  - '-readability-use-concise-preprocessor-directives'       #(TO_REVIEW:hits-in-clang-tidy-logs=10)(Yes)(Readability,Replaces #elif defined(...) with #elifdef and #elifndef directives.)
  - '-readability-simplify-boolean-expr'                     #(TO_REVIEW:hits-in-clang-tidy-logs=9)(Yes)(Readability,"Simplifies complex or redundant boolean logic (e.g., if (x == true) -> if (x)).")
  - '-modernize-pass-by-value'                               #(TO_REVIEW:hits-in-clang-tidy-logs=8)(Yes)(Modernize,Replaces const-reference parameters moved into class constructors with pass-by-value parameters.)
  - '-misc-unused-parameters'                                #(TO_REVIEW:hits-in-clang-tidy-logs=7)(Yes)(Misc,Detects unused function parameters and suggests removing or commenting them.)
  - '-modernize-deprecated-headers'                          #(TO_REVIEW:hits-in-clang-tidy-logs=7)(Yes)(Modernize,"Replaces C-style headers (e.g., <stdlib.h>) with C++ standard headers (e.g., <cstdlib>).")
  - '-modernize-use-nullptr'                                 #(TO_REVIEW:hits-in-clang-tidy-logs=7)(Yes)(Modernize,Replaces 0 and NULL macros with C++11 nullptr.)
  - '-readability-container-size-empty'                      #(TO_REVIEW:hits-in-clang-tidy-logs=7)(Yes)(Readability,Replaces .size() == 0 or .size() > 0 checks with .empty().)
  - '-bugprone-implicit-widening-of-multiplication-result'   #(TO_REVIEW:hits-in-clang-tidy-logs=6)(Yes)(Bugprone,"Detects integer multiplications whose results are implicitly widened, masking integer overflows.")
  - '-performance-move-const-arg'                            #(TO_REVIEW:hits-in-clang-tidy-logs=6)(Yes)(Performance,Flags std::move calls on const arguments or scalar types where moving has no effect.)
  - '-performance-unnecessary-copy-initialization'           #(TO_REVIEW:hits-in-clang-tidy-logs=6)(Yes)(Performance,Flags unnecessary copy initialization of local variables from const references or function returns.)
  - '-readability-const-return-type'                         #(TO_REVIEW:hits-in-clang-tidy-logs=6)(Yes)(Readability,Discourages returning const value types from functions.)
  - '-readability-redundant-casting'                         #(TO_REVIEW:hits-in-clang-tidy-logs=5)(Yes)(Readability,Warns on redundant type casts to identical types or redundant base/derived casts.)
  - '-readability-redundant-string-cstr'                     #(TO_REVIEW:hits-in-clang-tidy-logs=3)(Yes)(Readability,Removes redundant .c_str() calls passed to functions taking std::string or std::string_view.)

# Checks to review (no auto-fix, sorted in hits order):
  - '-misc-non-private-member-variables-in-classes'          #(TO_REVIEW:hits-in-clang-tidy-logs=836)(No)(Misc,Warns when class member variables are declared non-private.)
  - '-cppcoreguidelines-avoid-do-while'                      #(TO_REVIEW:hits-in-clang-tidy-logs=769)(No)(CppCoreGuidelines,Recommends replacing do-while loops with standard while or for loops.)
  - '-portability-avoid-pragma-once'                         #(TO_REVIEW:hits-in-clang-tidy-logs=585)(No)(Portability,Discourages using #pragma once in favor of standard header guards for cross-compiler portability.)
  - '-modernize-avoid-c-arrays'                              #(TO_REVIEW:hits-in-clang-tidy-logs=312)(No)(Modernize,Replaces C-style arrays with std::array or std::vector.)
  - '-readability-magic-numbers'                             #(TO_REVIEW:hits-in-clang-tidy-logs=271)(No)(Readability,Replaces hardcoded numeric literals (magic numbers) with named constants.)
  - '-cppcoreguidelines-pro-type-reinterpret-cast'           #(TO_REVIEW:hits-in-clang-tidy-logs=270)(No)(CppCoreGuidelines,Flags usage of reinterpret_cast.)
  - '-cppcoreguidelines-pro-bounds-pointer-arithmetic'       #(TO_REVIEW:hits-in-clang-tidy-logs=168)(No)(CppCoreGuidelines,Flags pointer arithmetic operations in favor of array/span abstractions.)
  - '-cppcoreguidelines-special-member-functions'            #(TO_REVIEW:hits-in-clang-tidy-logs=117)(No)(CppCoreGuidelines,Enforces the Rule of Zero / Rule of Five for special class member functions.)
  - '-readability-identifier-length'                         #(TO_REVIEW:hits-in-clang-tidy-logs=111)(No)(Readability,Flags variable or parameter names that are excessively short or long.)
  - '-performance-enum-size'                                 #(TO_REVIEW:hits-in-clang-tidy-logs=99)(No)(Performance,Recommends explicit underlying integer types for enums to optimize memory footprint.)
  - '-cppcoreguidelines-pro-type-vararg'                     #(TO_REVIEW:hits-in-clang-tidy-logs=92)(No)(CppCoreGuidelines,Flags C-style variadic arguments (...) in favor of variadic templates or std::initializer_list.)
  - '-bugprone-easily-swappable-parameters'                  #(TO_REVIEW:hits-in-clang-tidy-logs=90)(No)(Bugprone,Warns on adjacent function parameters of identical types that can be easily swapped by mistake.)
  - '-misc-override-with-different-visibility'               #(TO_REVIEW:hits-in-clang-tidy-logs=77)(No)(Misc,Flags virtual method overrides that alter base method access specifier visibility.)
  - '-cppcoreguidelines-avoid-const-or-ref-data-members'     #(TO_REVIEW:hits-in-clang-tidy-logs=67)(No)(CppCoreGuidelines,Flags const or reference struct members that inhibit copy/move assignment.)
  - '-cppcoreguidelines-use-enum-class'                      #(TO_REVIEW:hits-in-clang-tidy-logs=64)(No)(CppCoreGuidelines,Recommends enum class over unscoped enum.)
  - '-readability-function-cognitive-complexity'             #(TO_REVIEW:hits-in-clang-tidy-logs=59)(No)(Readability,Flags functions exceeding a configured cognitive complexity threshold.)
  - '-hicpp-signed-bitwise'                                  #(TO_REVIEW:hits-in-clang-tidy-logs=53)(No)(HICPP,Warns on bitwise operations applied to signed integer operands.)
  - '-cppcoreguidelines-pro-bounds-array-to-pointer-decay'   #(TO_REVIEW:hits-in-clang-tidy-logs=48)(No)(CppCoreGuidelines,Flags implicit array-to-pointer decay.)
  - '-bugprone-narrowing-conversions'                        #(TO_REVIEW:hits-in-clang-tidy-logs=36)(No)(Bugprone,Warns on implicit conversions that narrow type size or precision.)
  - '-bugprone-throwing-static-initialization'               #(TO_REVIEW:hits-in-clang-tidy-logs=33)(No)(Bugprone,Flags static or global variable initializers that may throw exceptions during startup.)
  - '-bugprone-lambda-function-name'                         #(TO_REVIEW:hits-in-clang-tidy-logs=29)(No)(Bugprone,Flags __func__ or __FUNCTION__ used inside lambdas where it evaluates to operator().)
  - '-cppcoreguidelines-macro-usage'                         #(TO_REVIEW:hits-in-clang-tidy-logs=28)(No)(CppCoreGuidelines,"Replaces preprocessor macros with const, constexpr, inline functions, or templates.")
  - '-cppcoreguidelines-pro-type-const-cast'                 #(TO_REVIEW:hits-in-clang-tidy-logs=21)(No)(CppCoreGuidelines,Flags usage of const_cast.)
  - '-bugprone-unhandled-self-assignment'                    #(TO_REVIEW:hits-in-clang-tidy-logs=20)(No)(Bugprone,Warns when custom copy/move assignment operators lack self-assignment protection.)
  - '-misc-unconventional-assign-operator'                   #(TO_REVIEW:hits-in-clang-tidy-logs=20)(No)(Misc,Ensures assignment operators follow standard idiomatic signatures (returning non-const *this reference).)
  - '-misc-multiple-inheritance'                             #(TO_REVIEW:hits-in-clang-tidy-logs=19)(No)(Misc,Flags classes using multiple inheritance (excluding pure interface classes).)
  - '-cppcoreguidelines-avoid-non-const-global-variables'    #(TO_REVIEW:hits-in-clang-tidy-logs=17)(No)(CppCoreGuidelines,Flags non-const global or namespace-scoped variables.)
  - '-bugprone-derived-method-shadowing-base-method'         #(TO_REVIEW:hits-in-clang-tidy-logs=15)(No)(Bugprone,Detects non-virtual derived class methods that shadow base class methods.)
  - '-cppcoreguidelines-missing-std-forward'                 #(TO_REVIEW:hits-in-clang-tidy-logs=12)(No)(CppCoreGuidelines,Flags forwarding references that fail to be passed through std::forward.)
  - '-cppcoreguidelines-pro-type-union-access'               #(TO_REVIEW:hits-in-clang-tidy-logs=11)(No)(CppCoreGuidelines,Discourages direct reads and writes to union fields.)
  - '-modernize-avoid-c-style-cast'                          #(TO_REVIEW:hits-in-clang-tidy-logs=9)(No)(Modernize,"Replaces C-style type casts with modern C++ casts (static_cast, const_cast, reinterpret_cast).")
  - '-cppcoreguidelines-no-malloc'                           #(TO_REVIEW:hits-in-clang-tidy-logs=5)(No)(CppCoreGuidelines,"Discourages C-style memory management (malloc, free) in favor of C++ abstractions.")
  - '-misc-no-recursion'                                     #(TO_REVIEW:hits-in-clang-tidy-logs=5)(No)(Misc,Warns on recursive function calls.)
  - '-cppcoreguidelines-owning-memory'                       #(TO_REVIEW:hits-in-clang-tidy-logs=4)(No)(CppCoreGuidelines,Enforces resource ownership semantics using gsl::owner.)
