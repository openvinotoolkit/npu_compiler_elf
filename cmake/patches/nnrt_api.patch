+    } hwp_cmx_mem_addr;
+
+    union {
+        uint32_t odu_cast;
+        struct {
+            uint32_t cast_enable : 1;
+            uint32_t reserved : 3;
+            uint32_t cast_offset : 28;
+        } odu_cast_bf;
+    } odu_cast[3];
+    uint32_t tensor2_start; // (VPU50XX+ only)
+
+    union {
+        uint32_t ppe_lut_ptr;
+        struct {
+            uint32_t ppe_lut_ptr : 16;
+            uint32_t unused_1 : 2;
+            uint32_t ppe_lut_ptr_force : 1;
+            uint32_t unused_2 : 13;
