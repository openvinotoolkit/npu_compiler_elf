+} VpuDPUInvariantRegisters;
+
+static_assert(sizeof(VpuDPUInvariantRegisters) == 288, "VpuDPUInvariantRegisters size != 288");
+
+/* VPU$ HALO Support */
+#define NUM_HALO_REGIONS 6
+
+typedef struct {
