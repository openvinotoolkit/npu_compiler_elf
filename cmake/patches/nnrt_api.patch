+
+    uint32_t weight_size;
+    uint32_t weight_num;
+    uint32_t weight_start;
+
+} VpuDPUVariantRegisters;
+
+static_assert(sizeof(VpuDPUVariantRegisters) == 192, "VpuDPUVariantRegisters size != 192");
