+
+namespace nn_public {
+
+#pragma pack(push, 1)
+
+typedef struct {
+    // IDU
+    struct {
+        uint32_t se_addr;
+        uint32_t sparsity_addr;
+    } se_sp_addr[4];
+
+    union {
+        uint32_t se_sp_size;
